<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- media flavor: drop the template service, be a MEDIA app instead -->
        <service android:name=".HelloCarAppService" tools:node="remove"/>
        <service android:name=".HelloMediaService" android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
    </application>
</manifest>
