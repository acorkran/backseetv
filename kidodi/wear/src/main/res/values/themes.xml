<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base on the device-default (round-aware) theme, but turn OFF the system swipe-to-dismiss so a
         right-swipe doesn't finish the activity. We handle swipe-right ourselves as a one-level BACK
         (sub-view -> player, player -> minimise) so it behaves identically on every page. -->
    <style name="KidodiWear" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
