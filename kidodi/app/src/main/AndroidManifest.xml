<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- read the local library off the SD card (grant via appops MANAGE_EXTERNAL_STORAGE allow) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- in-process control server (:8090) + mDNS/NSD advertise so remotes find the player -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- BLE control tier: player = peripheral (advertise), remote = central (scan); both connect -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <!-- pre-31 BLE -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <!-- keep the remote's connection (BLE/wifi) alive in a foreground service (also feeds Android Auto) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- boot straight into the show (v1 parity: the SHOW is the home screen) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- optional camera-monitor plugin: periodically-updated still images (off by default) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>

    <application
        android:label="Kidodi"
        android:icon="@android:drawable/ic_media_play"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <!-- Android Auto: a template (car) app, not a media app -->
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"/>
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1"/>

        <!-- Launcher: one APK, two roles. Routes to player or remote (first-run chooser). -->
        <activity
            android:name=".RouterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- also a HOME app: the show IS the home screen (device-owner pins us as preferred home) -->
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- Player role: the show is the home screen (fullscreen, landscape). -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"/>

        <!-- Optional "play mode": full-screen toddler-lock playground (WebView). -->
        <activity
            android:name=".PlayModeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"/>

        <!-- Remote role: control UI. -->
        <activity
            android:name=".RemoteActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- optional "locked" tier: device-owner APIs for inescapable lock-task -->
        <receiver android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>

        <!-- boot straight into the player (the SHOW is the home screen) -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- phone connection service: BLE primary + wifi fallback -->
        <service android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"/>

        <!-- optional camera-monitor plugin: headless still-image capture (off by default) -->
        <service android:name=".SnapshotService"
            android:exported="false"
            android:foregroundServiceType="camera"/>

        <!-- Android Auto car app (IOT category -> app launcher, not media slot) -->
        <service android:name=".KidodiCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <category android:name="androidx.car.app.category.IOT"/>
            </intent-filter>
        </service>
    </application>
</manifest>
