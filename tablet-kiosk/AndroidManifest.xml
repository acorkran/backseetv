<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kidstv.kiosk"
    android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- for the bridge's Zeroconf re-advertise on network change -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- to keep the Android media stream non-zero so Yatse's volume works -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- full-screen transparent overlay that swallows all touches to Kodi (kid-proofing) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- receive phone->tablet file uploads (over the 8080 bridge) into shared storage so Kodi can
         play them; granted via: adb shell appops set com.kidstv.kiosk MANAGE_EXTERNAL_STORAGE allow -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- let the in-app admin menu write the watchdog threshold (kiosk_watchdog_sec, a Global setting);
         grant once via: adb shell pm grant com.kidstv.kiosk android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <!-- run the bridge/overlay process foreground so LMK can't reap it during Kodi's boot storm -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- keep the bridge process/CPU alive with the screen off (Yatse "nap mode") so the
         wake command can still land -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- device-owner Wi-Fi config (addNetwork) so the appliance can be taught the home network -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <!-- v2 prototype: create a Wi-Fi Direct group (tablet-as-anchor). API 33 gates P2P group
         create/advertise behind NEARBY_WIFI_DEVICES; neverForLocation = we don't derive location. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"/>
    <!-- auto-join a paired phone's Bluetooth tether (PANU->NAP) so the driver never has to
         flip "Internet access" by hand -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <queries>
        <package android:name="org.xbmc.kodi"/>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
    <application android:label="KidsTV" android:icon="@android:drawable/ic_media_play"
        android:allowBackup="false">
        <activity android:name=".KioskActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data android:name="android.app.device_admin"
                android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- HTTP(8080) -> Kodi TCP(9090) bridge so Yatse/Kore work (Kodi's own
             web server never binds on this tablet). Foreground (specialUse) so the
             process - and the kid-proof touch overlay it protects - survives boot. -->
        <service android:name=".BridgeService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local JSON-RPC bridge and kid-proof kiosk touch overlay"/>
        </service>
        <!-- v2 prototype: Wi-Fi Direct "tablet is the anchor" group owner + _kidodi._tcp advert.
             Started on demand via the bridge /p2p endpoint; not part of the shipping boot path. -->
        <service android:name=".P2pAnchorService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="v2 Wi-Fi Direct anchor prototype"/>
        </service>
    </application>
</manifest>
