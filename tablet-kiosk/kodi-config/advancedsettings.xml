<advancedsettings>
  <!-- open straight to the TV Shows poster grid on every launch -->
  <startupwindow>
    <window>10025</window>
    <path>videodb://tvshows/titles/</path>
  </startupwindow>
  <!-- Shuffle appliance: don't track watch state. 101% is never reached, so episodes are
       never auto-marked "watched" (the addon also periodically wipes any resume points /
       watched flags, so the library stays pristine - no "unfinished episodes" clutter). -->
  <video>
    <ignoresecondsatstart>3</ignoresecondsatstart>
    <playcountminimumpercent>101</playcountminimumpercent>
  </video>
</advancedsettings>
