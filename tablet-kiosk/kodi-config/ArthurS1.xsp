<?xml version="1.0" encoding="UTF-8"?>
<smartplaylist type="episodes">
    <name>Arthur S1</name>
    <match>all</match>
    <rule field="tvshow" operator="is">
        <value>Arthur</value>
    </rule>
    <rule field="season" operator="is">
        <value>1</value>
    </rule>
    <rule field="path" operator="doesnotcontain">
        <value>mislabeled</value>
    </rule>
    <order direction="ascending">episode</order>
</smartplaylist>
