<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: status/now-playing + wifi + power header, a volume −/+ row, and a live
     scrollable grid of the tablet's playlists. All actions relay to Kodi via RemoteWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wbg"
    android:padding="12dp">

    <!-- header: status (tap = open app) | wifi (tap = hotspot settings) | power (tap = nap/wake) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView android:id="@+id/w_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KidsTV"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <ImageView android:id="@+id/w_wifi"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="7dp"
            android:background="@drawable/wbtn"
            android:src="@drawable/wic_wifi"
            android:contentDescription="Hotspot"/>

        <ImageView android:id="@+id/w_power"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="7dp"
            android:background="@drawable/wbtn"
            android:src="@drawable/wic_power"
            android:contentDescription="Power"/>
    </LinearLayout>

    <!-- volume: −  [level]  + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView android:id="@+id/w_voldown"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/wbtn"
            android:src="@drawable/wic_voldown"
            android:contentDescription="Volume down"/>

        <TextView android:id="@+id/w_vol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="VOL"
            android:textColor="#FF9DB0C6"
            android:textSize="14sp"/>

        <ImageView android:id="@+id/w_volup"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/wbtn"
            android:src="@drawable/wic_volup"
            android:contentDescription="Volume up"/>
    </LinearLayout>

    <!-- live playlist grid (RemoteViewsService); auto-fits columns to the widget width -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <GridView android:id="@+id/w_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:columnWidth="88dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp"
            android:horizontalSpacing="8dp"
            android:gravity="center"/>

        <TextView android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Searching for tablet…"
            android:textColor="#FF9DB0C6"
            android:textSize="14sp"/>
    </FrameLayout>
</LinearLayout>
